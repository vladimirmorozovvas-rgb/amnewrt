CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_tplink_archer-c6-v2=y

# LuCI
CONFIG_PACKAGE_luci=y
# CONFIG_PACKAGE_luci-ssl is not set

# Сеть
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# PBR
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y

# Wi-Fi
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# AmneziaWG
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y

# Оптимизация размера
CONFIG_USE_SSTRIP=y
CONFIG_STRIP_KERNEL_EXPORTS=y

# Удаляем лишнее
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_kmod-ipv6 is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_openssh-sftp-server is not set
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_uclient-fetch is not set
# CONFIG_PACKAGE_ca-bundle is not set
